{
  "name": "medusa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=/test/integration/",
    "test:integration": "jest --runInBand test/integration --passWithNoTests",
    "test:e2e": "jest --runInBand test/e2e --passWithNoTests",
    "test": "npm run test:unit && npm run test:integration",
    "build": "next build",
    "start": "next start",
    "ci:verify": "npm ci && npm run typecheck && npm run lint && npm run test && npm run build",
    "health:startup": "node -e \"fetch('http://localhost:3000/api/health/startup').then(async (r) => { const body = await r.json(); console.log(JSON.stringify({ status: r.status, body }, null, 2)); process.exit(r.ok ? 0 : 1); }).catch((e) => { console.error(e.message); process.exit(1); })\"",
    "appwrite:cleanup-duplicates": "node scripts/cleanup-duplicate-collections.js",
    "appwrite:cleanup-duplicates:apply": "node scripts/cleanup-duplicate-collections.js --apply",
    "test:watch": "jest --watch",
    "test:ci": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.8",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "appwrite": "^17.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.1",
    "ioredis": "^5.8.1",
    "lucide-react": "^0.454.0",
    "next": "^15.5.15",
    "node-appwrite": "^14.2.0",
    "react": "19.0.0-rc-02c0e824-20241028",
    "react-dom": "19.0.0-rc-02c0e824-20241028",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.53.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "use-debounce": "^10.0.4",
    "zod": "^3.23.8"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "brace-expansion@^1.1.7": "1.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.15",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "jest": "^29.7.0",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  }
}
